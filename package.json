{
  "name": "zhipu-mermaid-theme",
  "version": "0.1.0",
  "description": "A clean-room Mermaid theme reconstruction with responsive Timeline layout fixes.",
  "type": "module",
  "main": "./dist/zhipu-mermaid-theme.js",
  "module": "./dist/zhipu-mermaid-theme.js",
  "exports": {
    ".": "./dist/zhipu-mermaid-theme.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "node scripts/vite-random-port.mjs",
    "build": "pnpm run build:lib && pnpm run build:demo",
    "build:lib": "vite build --config vite.lib.config.js",
    "build:demo": "vite build --outDir dist-demo",
    "preview": "node scripts/vite-random-port.mjs preview --outDir dist-demo",
    "check": "node --check src/zhipu-mermaid-theme.js && node --check src/main.js && node --check src/gallery.js && node --check scripts/vite-random-port.mjs"
  },
  "keywords": [
    "mermaid",
    "timeline",
    "theme",
    "responsive"
  ],
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "canvg": "^4.0.3",
    "hammerjs": "2.0.8",
    "mermaid": "11.16.1",
    "svg-pan-zoom": "3.6.2"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  }
}
